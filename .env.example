# Chave da OpenRouter — obrigatória
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Token do Cloudflare Named Tunnel — obrigatório para docker-compose
# Obtenha em: https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels
# Crie um tunnel, copie o token e configure o hostname público apontando para:
#   http://mcp-server:8000
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Porta do servidor HTTP (opcional — padrão: 8000)
# MCP_PORT=8000
